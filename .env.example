# Copy to .env and fill in the three keys below. .env is git-ignored.

# 1. Discord bot token.
#    https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# 2. Gemini API key — powers transcription, the conversation, and the
#    "should I speak?" check.
#
#    https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=

# 3. ElevenLabs API key — the voice.
#    https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
#  Optional. The defaults are fine; change only if you want to.
# ---------------------------------------------------------------------------

# Your server (guild) id. Setting it makes /join, /leave and /status appear
# within seconds instead of up to an hour. Right-click the server ->
# Copy Server ID (needs Developer Mode in Discord settings -> Advanced).
DISCORD_SERVER_ID=

# Application identifiers. The bot itself does not read these — they are kept
# here so every credential lives in one place. The client id is what builds the
# invite URL; the public key verifies incoming webhooks (unused); the client
# secret is for OAuth2 logins on behalf of users (unused).
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=

# Voice channel to join automatically on startup. Leave empty to have the bot
# sit idle until someone runs /join from inside a voice channel.
DISCORD_VOICE_CHANNEL_ID=

# How eagerly it joins in, 0-100.
#   0   = only answers when called by name
#   65  = default: an engaged participant
#   100 = talks as much as it plausibly can
# Every uninvited remark still has to pass a "is this worth saying?" check.
BOT_TALKATIVENESS=65

# Reply language. Empty = answer in whatever language the speaker used
# (Ukrainian, Russian or English). Set e.g. uk-UA to pin one language.
BOT_REPLY_LANGUAGE=

# Languages to expect. Detection is automatic; these only bias it.
GEMINI_STT_LANGUAGE_HINTS=uk-UA,ru-RU,en-US

# Stop talking when a human speaks over the bot.
BOT_BARGE_IN=true

# Greet people when the bot joins and when someone enters the channel.
BOT_GREET_ON_JOIN=true

# Require every speaker to run /consent accept before being transcribed.
# Off by default, otherwise a freshly invited bot hears nobody. The bot always
# posts a notice in the channel when it joins.
BOT_REQUIRE_CONSENT=false

# Transcription backend.
#   batch — one request per utterance. ~2s to transcribe. VERIFIED WORKING.
#   live  — streams into the Live API. Lower latency in principle, but the
#           service aborts the socket (1008) when a whole buffered utterance is
#           pushed at once, which is how this bot segments speech. Leave on
#           batch unless you have reworked the coordinator for a persistent,
#           real-time-fed session per speaker.
GEMINI_STT_BACKEND=batch
GEMINI_STT_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_STT_BATCH_MODEL=gemini-2.5-flash

# ElevenLabs model. Flash v2.5 is the fastest and covers uk/ru/en.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Set to true for verbose logs when something is not working.
DEBUG_MODE=false
